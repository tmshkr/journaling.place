# Deployment settings for `npm run config` (set-config.mjs). Gitignored as .env.
# One stack per environment, so configure each with --stack.

# --- Cluster ---
# Path to a kubeconfig; its contents are stored as a stack secret.
# Omit to use whatever context kubectl is currently pointed at.
# KUBECONFIG=~/.kube/config
# KUBE_CONTEXT=
# K8S_NAMESPACE=default
# Other stacks share the namespace, so at most one stack may own it.
# For `default` leave it off entirely.
# CREATE_NAMESPACE=false

# --- Release ---
# The image tag to run. CI pushes tmshkr/journaling.place:<branch>-<sha>.
VERSION_LABEL=
# IMAGE_REPOSITORY=tmshkr/journaling.place
# REPLICAS=1

# --- Routing ---
# The host this environment serves; also names the Ingress.
TARGET_DOMAIN=staging.journaling.place
# INGRESS_ENABLED=true
# INGRESS_CLASS_NAME=cloudflare-tunnel

# --- App ---
# Defaults to https://<TARGET_DOMAIN>.
# NEXTAUTH_URL=
NEXTAUTH_SECRET=
# In-cluster connection string, e.g. for oci-k3s databases/mongodb stack `dev`:
#   mongodb://<user>:<password>@mongodb-dev.default.svc.cluster.local:27017/<database>?replicaSet=rs0&authSource=admin
MONGO_URI=
EMAIL_FROM=
EMAIL_SECRET=
# SMTP connection string.
EMAIL_SERVER=
TEST_USER_EMAIL=
# PRISMA_QUERY_ENGINE_LIBRARY=/app/node_modules/@prisma/engines/libquery_engine-linux-arm64-openssl-3.0.x.so.node
