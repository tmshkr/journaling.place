{
  "name": "journaling.place",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "build": "turbo run build --filter='./apps/*' --cache-dir=.turbo --env-mode=loose",
    "dev": "prisma db push && prisma db seed && turbo run dev --env-mode=loose",
    "dev:web": "turbo run dev --filter=web --filter=trpc-server",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:test": "docker compose -f docker-compose.test.yml up",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "gha:eb-deploy": "./scripts/github/run-workflow.js eb-deploy.yaml",
    "gha:gcp-deploy": "./scripts/github/run-workflow.js gcp-deploy.yaml",
    "gha:promote": "./scripts/github/run-workflow.js promote.yaml",
    "start": "prisma db push && prisma db seed && turbo run start --env-mode=loose",
    "e2e:test": "dotenvx run -f test.env -- npm run test --workspace e2e",
    "e2e:report": "turbo run report --filter=e2e",
    "jest": "turbo run jest --filter=trpc-server",
    "update-dockerfiles": "./scripts/update-dockerfiles.mjs Dockerfile Dockerfile.dev",
    "tf:compute:destroy": "./scripts/terraform/select-staging-workspace.sh && cd terraform/compute && terraform destroy"
  },
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.0",
    "@vercel/ncc": "^0.38.4",
    "axios": "^1.13.5",
    "cookie": "^1.1.1",
    "dayjs": "^1.11.19",
    "email-templates": "^13.0.1",
    "eslint": "^9.7.0",
    "eslint-config-custom": "*",
    "eslint-config-next": "16.1.6",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jest-mock-extended": "^4.0.0",
    "mongodb": "^7.1.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.7",
    "nodemon": "^3.1.14",
    "prettier": "latest",
    "prisma": "^6.19.2",
    "pug": "^3.0.3",
    "ts-jest": "^29.4.6",
    "turbo": "^2.8.10",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.3.1"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
